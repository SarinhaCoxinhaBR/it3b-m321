# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# Datenbank. Der Container legt Benutzer und Datenbank beim ersten Start an.
POSTGRES_USER=chat
POSTGRES_PASSWORD=bitte-lokal-aendern
POSTGRES_DB=chat

# batch-writer, Begründung in docs/spec-batch-writer.md 3.1 und 3.2.
# Höchstens so viele Nachrichten pro Paket, zugleich der Prefetch.
BATCH_WRITER_BATCH_SIZE=500
# Spätestens nach so vielen Millisekunden wird ein Paket geschrieben.
BATCH_WRITER_BATCH_TIMEOUT_MS=200
# Pause in Millisekunden zwischen zwei Versuchen, solange die Datenbank fehlt.
BATCH_WRITER_RETRY_DELAY_MS=2000
